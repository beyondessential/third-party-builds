#!/bin/sh
set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

if [ "$1" = "remove" ]; then
    deb-systemd-helper mask upki-fetch.timer >/dev/null || true
fi

if [ "$1" = "purge" ]; then
    deb-systemd-helper purge upki-fetch.timer >/dev/null || true
    deb-systemd-helper unmask upki-fetch.timer >/dev/null || true
    rm -rf /var/cache/upki /var/lib/upki
fi
